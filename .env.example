# Supabase Configuration for LOOP
# Copy this file to .env.local and fill in your project values:
#   cp .env.example .env.local
#
# In your Supabase dashboard:
#   Project Settings -> API -> Project URL & Project API Keys (anon / publishable)
#
# Never commit .env.local to version control.
# Never use or expose the service_role secret key in client-facing code.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
